<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Body"
            android:text="@string/tagline" />

        <!-- On and off. -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/state_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_off" />

                <TextView
                    android:id="@+id/state_text"
                    style="@style/CardTitle"
                    android:layout_marginStart="10dp"
                    android:text="@string/state_off" />
            </LinearLayout>

            <TextView
                android:id="@+id/state_note"
                style="@style/Body"
                android:text="@string/state_off_note" />

            <Button
                android:id="@+id/toggle"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/start" />

            <TextView
                android:id="@+id/status"
                style="@style/Note"
                android:visibility="gone" />
        </LinearLayout>

        <!-- How to use it. -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/howto_title" />

            <LinearLayout style="@style/StepRow">

                <TextView
                    style="@style/Step"
                    android:text="1" />

                <TextView
                    style="@style/StepText"
                    android:text="@string/howto_1" />
            </LinearLayout>

            <LinearLayout style="@style/StepRow">

                <TextView
                    style="@style/Step"
                    android:text="2" />

                <TextView
                    style="@style/StepText"
                    android:text="@string/howto_2" />
            </LinearLayout>

            <LinearLayout style="@style/StepRow">

                <TextView
                    style="@style/Step"
                    android:text="3" />

                <TextView
                    style="@style/StepText"
                    android:text="@string/howto_3" />
            </LinearLayout>

            <LinearLayout style="@style/StepRow">

                <TextView
                    style="@style/Step"
                    android:text="4" />

                <TextView
                    style="@style/StepText"
                    android:text="@string/howto_4" />
            </LinearLayout>

            <LinearLayout style="@style/StepRow">

                <TextView
                    style="@style/Step"
                    android:text="5" />

                <TextView
                    style="@style/StepText"
                    android:text="@string/howto_5" />
            </LinearLayout>
        </LinearLayout>

        <!-- Translation. -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/translation_title" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="12dp"
                android:text="@string/label_target" />

            <Spinner
                android:id="@+id/target"
                style="@style/Field" />

            <TextView
                android:id="@+id/model_status"
                style="@style/Note" />

            <Button
                android:id="@+id/download"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/download_now"
                android:visibility="gone" />

            <TextView
                style="@style/Label"
                android:text="@string/label_script" />

            <Spinner
                android:id="@+id/script"
                style="@style/Field" />

            <TextView
                style="@style/Note"
                android:text="@string/script_note" />
        </LinearLayout>

        <!-- Live translation. -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/live_title" />

                    <TextView
                        style="@style/Body"
                        android:text="@string/live_note" />
                </LinearLayout>

                <Switch
                    android:id="@+id/live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/live_title"
                    android:minHeight="48dp" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:text="@string/menu_region" />

            <Spinner
                android:id="@+id/region"
                style="@style/Field" />

            <TextView
                style="@style/Note"
                android:text="@string/region_note" />
        </LinearLayout>

        <!-- Automatic subtitles. -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/subtitles_title" />

                    <TextView
                        style="@style/Body"
                        android:text="@string/subtitles_note" />
                </LinearLayout>

                <Switch
                    android:id="@+id/subtitles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/subtitles_title"
                    android:minHeight="48dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/engine_note"
                style="@style/Note"
                android:textColor="@color/danger"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/subtitle_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:text="@string/label_listen" />

                <Spinner
                    android:id="@+id/listen"
                    style="@style/Field" />

                <TextView
                    android:id="@+id/listen_note"
                    style="@style/Note"
                    android:text="@string/listen_note" />

                <TextView
                    style="@style/Label"
                    android:text="@string/label_spoken" />

                <Spinner
                    android:id="@+id/spoken"
                    style="@style/Field" />

                <TextView
                    style="@style/Label"
                    android:text="@string/label_model" />

                <Spinner
                    android:id="@+id/model"
                    style="@style/Field" />

                <TextView
                    style="@style/Note"
                    android:text="@string/model_note" />

                <TextView
                    style="@style/Label"
                    android:text="@string/label_size" />

                <Spinner
                    android:id="@+id/text_size"
                    style="@style/Field" />

                <Switch
                    android:id="@+id/show_original"
                    style="@style/SwitchRow"
                    android:text="@string/show_original" />

                <TextView
                    android:id="@+id/stats"
                    style="@style/Note" />
            </LinearLayout>
        </LinearLayout>

        <!-- More. -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/more_title" />

            <Button
                android:id="@+id/add_tile"
                style="@style/SecondaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/add_tile"
                android:visibility="gone" />

            <Button
                android:id="@+id/battery"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/battery"
                android:visibility="gone" />

            <TextView
                android:id="@+id/battery_note"
                style="@style/Note"
                android:text="@string/battery_note"
                android:visibility="gone" />

            <TextView
                android:id="@+id/maker_note"
                style="@style/Note"
                android:visibility="gone" />

            <Button
                android:id="@+id/app_settings"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/app_settings"
                android:visibility="gone" />

            <Button
                android:id="@+id/copy_log"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/copy_log" />

            <TextView
                style="@style/Note"
                android:text="@string/copy_log_note" />
        </LinearLayout>

        <!-- About. -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/about_title" />

            <TextView
                style="@style/Body"
                android:text="@string/privacy" />

            <TextView
                style="@style/Body"
                android:text="@string/about_google" />

            <TextView
                style="@style/Note"
                android:text="@string/disclaimer" />

            <TextView
                android:id="@+id/version"
                style="@style/Note" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
