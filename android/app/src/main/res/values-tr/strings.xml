    <string name="state_on">Açık</string>
    <string name="state_off">Kapalı</string>
    <string name="state_on_note">Herhangi bir uygulamada ekranın kenarındaki balona dokun; ekran çevrilir. Menü için balona basılı tut.</string>
    <string name="state_off_note">Başlatınca ekranının kenarında, tüm uygulamaların üzerinde küçük bir balon belirir.</string>
